{
  "name": "bace",
  "version": "5.4.0",
  "description": "Aplicación BACE Electron",
  "main": "electron/dist-electron/index.js",
  "author": "Luis Rodriguez",
  "license": "ISC",
  "scripts": {
    "postinstall": "",
    "build:electron": "tsc",
    "build:renderer": "cd renderer && pnpm run build",
    "build": "pnpm run build:electron && pnpm run build:renderer",
    "watch:electron": "tsc -w",
    "dev:electron": "electron ./electron/dist-electron --no-sandbox",
    "dev": "tsc && concurrently -k --success first \"tsc -w\" \"pnpm run dev:electron\" \"cd renderer && pnpm run dev\"",
    "dist": "pnpm run build && electron-builder",
    "dist:win": "pnpm run build && electron-builder --win",
    "dist:git": "pnpm run build && electron-builder --win -p always"
  },
  "keywords": [],
  "packageManager": "pnpm@10.29.1",
  "devDependencies": {
    "@electron/rebuild": "3.2.13",
    "@types/bcryptjs": "2.4.6",
    "@types/fs-extra": "^11.0.1",
    "@types/mime-types": "2.1.4",
    "@types/node": "^16.18.0",
    "@types/pg": "^8.10.9",
    "@types/uuid": "^9.0.7",
    "concurrently": "^8.2.2",
    "electron": "22.3.9",
    "electron-builder": "^26.0.12",
    "typescript": "5.2.2"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "dotenv": "^16.4.5",
    "electron-log": "5.1.4",
    "fs-extra": "^11.1.1",
    "mime-types": "^2.1.35",
    "pg": "^8.11.5",
    "uuid": "^9.0.1"
  },
  "build": {
    "appId": "com.bace.electron",
    "productName": "BACE",
    "publish": [
      {
        "provider": "github",
        "owner": "LuisRodriguez27",
        "repo": "BACE-ELECTRON"
      }
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/dist-electron/**/*",
      "renderer/dist/**/*",
      "node_modules/**/*",
      ".env",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "verifyUpdateCodeSignature": false,
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BACE"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    }
  }
}
